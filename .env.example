# Copy to .env and fill in. Never commit .env.

# --- Django ---
DJANGO_SECRET_KEY=dev-only-change-me-in-production
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Datastores ---
# Leave these commented for a local run: the app falls back to SQLite and an
# in-process cache. docker-compose injects the real values when you use it.
# DATABASE_URL=postgres://deskpilot:deskpilot@localhost:5433/deskpilot
# REDIS_URL=redis://localhost:6380/0
POSTGRES_PASSWORD=deskpilot

# --- LLM (provider-agnostic, OpenAI-compatible endpoint) ---
# Any OpenAI-compatible provider works. Examples:
#   APINEX    https://api.apinex.bond/v1              free/deepseek-v4.1-flash
#   Groq      https://api.groq.com/openai/v1          llama-3.3-70b-versatile
#   OpenAI    https://api.openai.com/v1               gpt-4o-mini
#   Ollama    http://127.0.0.1:11434/v1               llama3.1
# After setting these, run `python manage.py check_llm` before anything else.
LLM_API_KEY=
LLM_BASE_URL=https://api.apinex.bond/v1
LLM_MODEL=free/deepseek-v4.1-flash

# Some providers (IteraCompute) need {"reasoning": false} in the request body;
# others (Groq, OpenAI) reject unknown fields. Leave 0 unless you know you need it.
LLM_SEND_REASONING_PARAM=0

# Hard ceiling so a looping agent cannot burn budget. Enforced in the runtime.
LLM_MAX_COST_PER_RUN_USD=0.15

# --- Safety ---
# SAFE_MODE=1 routes every write tool to a simulated host. Keep it on until you
# have read docs/guardrails.md and deliberately want real actions on this machine.
SAFE_MODE=1
ALLOW_REAL_WRITES=0

# --- Host agent (M1+, runs natively on Windows) ---
# The agent refuses every request until this is set, and `prod.py` refuses to boot
# if it is still the value below. Generate a real one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
HOSTAGENT_URL=http://host.docker.internal:8765
HOSTAGENT_TOKEN=dev-shared-secret

# --- Directory (identity) ---
# "fake" uses the seeded local tenant; "ldap" talks to a real directory.
DIRECTORY_BACKEND=fake
# Required when DIRECTORY_BACKEND=ldap. There is deliberately no default: a bind
# password that silently falls back to a known string works, so nobody notices.
LDAP_URI=ldap://localhost:3890
LDAP_BASE_DN=dc=deskpilot,dc=test
LDAP_BIND_DN=cn=admin,dc=deskpilot,dc=test
LDAP_BIND_PASSWORD=

# --- Rate limits ---
# Without these, /auth/login/ is an unlimited password-guessing oracle.
THROTTLE_ANON=60/min
THROTTLE_USER=600/min

# --- Vault ---
# Encrypts generated directory passwords at rest. Any long random string works; it
# is stretched with SHA-256 into a Fernet key. When empty it is derived from
# DJANGO_SECRET_KEY, which keeps a fresh clone working — but prod.py requires an
# explicit value, so rotating SECRET_KEY cannot silently orphan stored credentials.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
VAULT_ENCRYPTION_KEY=

# --- CORS ---
# The console runs on 3001; 3000 is kept for a second instance.
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
